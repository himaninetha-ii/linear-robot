<?xml version="1.0"?>
<robot name="gantry_robot">

  <!-- ================= WORLD ================= -->
  <link name="world"/>

  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
  </joint>

  <!-- ================= GAZEBO CONTROL ================= -->
  <gazebo>
    <plugin filename="libgz_ros2_control-system.so" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>/home/himani/ros2_ws/src/gantry_description/config/controllers.yaml</parameters>
    </plugin>
  </gazebo>

  <ros2_control name="GantrySystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <joint name="x_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="y_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="z_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="wrist_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="left_finger_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <!-- ================= STRUCTURE ================= -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.025"/>
      <geometry>
        <box size="2.20 1.40 0.05"/>
      </geometry>
      <material name="frame_gray">
        <color rgba="0.45 0.45 0.45 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.025"/>
      <geometry>
        <box size="2.20 1.40 0.05"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.025"/>
      <mass value="120.0"/>
      <inertia ixx="40.0" iyy="80.0" izz="80.0" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- Four vertical corner pillars -->
  <link name="pillar_fl_link">
    <visual>
      <origin xyz="1.05 0.65 0.925"/>
      <geometry>
        <box size="0.08 0.08 1.85"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="1.05 0.65 0.925"/>
      <geometry>
        <box size="0.08 0.08 1.85"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="1.05 0.65 0.925"/>
      <mass value="20.0"/>
      <inertia ixx="6.0" iyy="6.0" izz="0.1" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <joint name="pillar_fl_joint" type="fixed">
    <parent link="base_link"/>
    <child link="pillar_fl_link"/>
  </joint>

  <link name="pillar_fr_link">
    <visual>
      <origin xyz="1.05 -0.65 0.925"/>
      <geometry>
        <box size="0.08 0.08 1.85"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="1.05 -0.65 0.925"/>
      <geometry>
        <box size="0.08 0.08 1.85"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="1.05 -0.65 0.925"/>
      <mass value="20.0"/>
      <inertia ixx="6.0" iyy="6.0" izz="0.1" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <joint name="pillar_fr_joint" type="fixed">
    <parent link="base_link"/>
    <child link="pillar_fr_link"/>
  </joint>

  <link name="pillar_rl_link">
    <visual>
      <origin xyz="-1.05 0.65 0.925"/>
      <geometry>
        <box size="0.08 0.08 1.85"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="-1.05 0.65 0.925"/>
      <geometry>
        <box size="0.08 0.08 1.85"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="-1.05 0.65 0.925"/>
      <mass value="20.0"/>
      <inertia ixx="6.0" iyy="6.0" izz="0.1" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <joint name="pillar_rl_joint" type="fixed">
    <parent link="base_link"/>
    <child link="pillar_rl_link"/>
  </joint>

  <link name="pillar_rr_link">
    <visual>
      <origin xyz="-1.05 -0.65 0.925"/>
      <geometry>
        <box size="0.08 0.08 1.85"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="-1.05 -0.65 0.925"/>
      <geometry>
        <box size="0.08 0.08 1.85"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="-1.05 -0.65 0.925"/>
      <mass value="20.0"/>
      <inertia ixx="6.0" iyy="6.0" izz="0.1" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <joint name="pillar_rr_joint" type="fixed">
    <parent link="base_link"/>
    <child link="pillar_rr_link"/>
  </joint>

  <!-- Top beam over rear pillars -->
  <link name="top_cross_beam_left">
    <visual>
      <origin xyz="0 0.65 1.85"/>
      <geometry>
        <box size="2.10 0.08 0.08"/>
      </geometry>
      <material name="frame_dark">
        <color rgba="0.25 0.25 0.25 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0.65 1.85"/>
      <geometry>
        <box size="2.10 0.08 0.08"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0.65 1.85"/>
      <mass value="20.0"/>
      <inertia ixx="0.1" iyy="7.5" izz="7.5" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="base_to_top_cross_beam_left" type="fixed">
    <parent link="base_link"/>
    <child link="top_cross_beam_left"/>
  </joint>

  <!-- Top beam over front pillars -->
  <link name="top_cross_beam_right">
    <visual>
      <origin xyz="0 -0.65 1.85"/>
      <geometry>
        <box size="2.10 0.08 0.08"/>
      </geometry>
      <material name="frame_dark">
        <color rgba="0.25 0.25 0.25 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 -0.65 1.85"/>
      <geometry>
        <box size="2.10 0.08 0.08"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 -0.65 1.85"/>
      <mass value="20.0"/>
      <inertia ixx="0.1" iyy="7.5" izz="7.5" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="base_to_top_cross_beam_right" type="fixed">
    <parent link="base_link"/>
    <child link="top_cross_beam_right"/>
  </joint>

  <!-- ================= CORRECTED MOTION CHAIN ================= -->

  <!-- X beam (bridge between Y rails) -->
  <link name="x_link">
    <visual>
      <origin xyz="0 0 0"/>
      <geometry>
        <box size="0.18 0.18 0.18"/>
      </geometry>
      <material name="axis_blue">
        <color rgba="0.20 0.40 0.85 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0"/>
      <geometry>
        <box size="0.18 0.18 0.18"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="5.0"/>
      <inertia ixx="0.03" iyy="0.03" izz="0.03" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- Y carriage moves along X beam -->
  <link name="y_link">
    <visual>
      <origin xyz="0 0 0"/>
      <geometry>
        <box size="0.12 1.60 0.18"/>
      </geometry>
      <material name="axis_orange">
        <color rgba="0.95 0.55 0.20 1.0"/>
      </material>
    </visual>
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="15.0"/>
      <inertia ixx="3.5" iyy="0.1" izz="3.5" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="y_joint" type="prismatic">
    <parent link="base_link"/>
    <child link="y_link"/>
    <origin xyz="0 0 1.80"/>
    <axis xyz="1 0 0"/>   <!-- along X beam -->
    <limit lower="0.0" upper="1.1" effort="1200" velocity="1.2"/>
  </joint>

  <!-- X moves along Y rails -->
  <joint name="x_joint" type="prismatic">
    <parent link="y_link"/>
    <child link="x_link"/>
    <origin xyz="0 0 0"/>
    <axis xyz="0 1 0"/>   <!-- along Y rails -->
    <limit lower="-0.65" upper="0.65" effort="1500" velocity="1.5"/>
  </joint>

  <link name="z_link">
    <visual>
      <origin xyz="0 0 0"/>
      <geometry>
        <box size="0.18 0.18 1.00"/>
      </geometry>
      <material name="axis_green">
        <color rgba="0.20 0.75 0.25 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0"/>
      <geometry>
        <box size="0.18 0.18 1.00"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="7.0"/>
      <inertia ixx="0.12" iyy="0.12" izz="0.05" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="z_joint" type="prismatic">
    <parent link="x_link"/>
    <child link="z_link"/>
    <origin xyz="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.5" upper="0.5" effort="1500" velocity="0.8"/>
  </joint>

  <link name="wrist_mount_link">
    <visual>
      <origin xyz="0 0 -0.40"/>
      <geometry>
        <box size="0.14 0.14 0.80"/>
      </geometry>
      <material name="axis_teal">
        <color rgba="0.10 0.60 0.60 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 -0.40"/>
      <geometry>
        <box size="0.14 0.14 0.80"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 -0.40"/>
      <mass value="5.0"/>
      <inertia ixx="0.08" iyy="0.08" izz="0.03" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="z_to_wrist_mount_joint" type="fixed">
    <parent link="z_link"/>
    <child link="wrist_mount_link"/>
    <origin xyz="0 0 0"/>
  </joint>

  <link name="gripper_base">
    <visual>
      <origin xyz="0 0 -0.03"/>
      <geometry>
        <box size="0.20 0.10 0.06"/>
      </geometry>
      <material name="gripper_black">
        <color rgba="0.10 0.10 0.10 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 -0.03"/>
      <geometry>
        <box size="0.20 0.10 0.06"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 -0.03"/>
      <mass value="1.0"/>
      <inertia ixx="0.004" iyy="0.004" izz="0.004" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="wrist_joint" type="continuous">
    <parent link="wrist_mount_link"/>
    <child link="gripper_base"/>
    <origin xyz="0 0 -0.80"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="left_finger">
    <visual>
      <origin xyz="0.04 0 0"/>
      <geometry>
        <box size="0.08 0.02 0.12"/>
      </geometry>
      <material name="finger_metal">
        <color rgba="0.75 0.75 0.75 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.04 0 0"/>
      <geometry>
        <box size="0.08 0.02 0.12"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.04 0 0"/>
      <mass value="0.15"/>
      <inertia ixx="0.0005" iyy="0.0005" izz="0.0005" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="left_finger_joint" type="prismatic">
    <parent link="gripper_base"/>
    <child link="left_finger"/>
    <origin xyz="0 0.05 -0.06"/>
    <axis xyz="0 -1 0"/>
    <limit lower="0.0" upper="0.04" effort="40" velocity="0.2"/>
  </joint>

  <link name="right_finger">
    <visual>
      <origin xyz="0.04 0 0"/>
      <geometry>
        <box size="0.08 0.02 0.12"/>
      </geometry>
      <material name="finger_metal_2">
        <color rgba="0.70 0.70 0.70 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.04 0 0"/>
      <geometry>
        <box size="0.08 0.02 0.12"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.04 0 0"/>
      <mass value="0.15"/>
      <inertia ixx="0.0005" iyy="0.0005" izz="0.0005" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="right_finger_joint" type="prismatic">
    <parent link="gripper_base"/>
    <child link="right_finger"/>
    <origin xyz="0 -0.05 -0.06"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="0.04" effort="40" velocity="0.2"/>
    <mimic joint="left_finger_joint" multiplier="1.0" offset="0.0"/>
  </joint>

  <!-- Explicit transmissions for Gazebo control mapping -->
  <transmission name="x_joint_transmission">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="x_joint">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="x_joint_motor">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <transmission name="y_joint_transmission">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="y_joint">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="y_joint_motor">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <transmission name="z_joint_transmission">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="z_joint">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="z_joint_motor">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

</robot>
